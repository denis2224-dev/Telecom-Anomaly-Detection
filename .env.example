# Copy to .env and generate separate local passwords as described in the runbook.
COMPOSE_PROJECT_NAME=telecom-anomaly

POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=telecom_admin
POSTGRES_PASSWORD=

PROCESSING_DB_USER=processing_app
PROCESSING_DB_PASSWORD=
PROCESSING_MIGRATOR_USER=processing_migrator
PROCESSING_MIGRATOR_PASSWORD=
PROCESSING_DB_URL=jdbc:postgresql://localhost:5432/processing_db?currentSchema=app

INCIDENT_DB_USER=incidents_app
INCIDENT_DB_PASSWORD=
INCIDENT_MIGRATOR_USER=incidents_migrator
INCIDENT_MIGRATOR_PASSWORD=
INCIDENT_DB_URL=jdbc:postgresql://localhost:5432/incidents_db?currentSchema=app

KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=
# Bootstrap administrator for the Keycloak administration console.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
# Backend-only secret; scripts/prepare-keycloak fills this in local .env.
KEYCLOAK_CLIENT_SECRET=

KAFKA_HOST_PORT=9094
# Host/IDE address; Compose application containers use kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_PARTITIONS=3
KAFKA_RAW_RETENTION_MS=86400000
KAFKA_DERIVED_RETENTION_MS=604800000
KAFKA_V2_OBSERVATIONS_TOPIC=telecom.observations.v2
KAFKA_V2_KPIS_TOPIC=telecom.kpis.v2
KAFKA_V2_DETECTIONS_TOPIC=telecom.detections.v2
KAFKA_V2_INVALID_TOPIC=telecom.observations.invalid.v2
KAFKA_V2_LATE_TOPIC=telecom.observations.late.v2
KAFKA_READINESS_TIMEOUT=2s
KAFKA_READINESS_POLL_INTERVAL=1s

ML_BASE_URL=http://ml-service:8000
GENERATOR_BASE_URL=http://event-generator:8081
FEATURE_VERSION=1
GENERATOR_SEED=15092026
GENERATOR_COUNT=10
