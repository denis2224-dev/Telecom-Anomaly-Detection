# Local demo defaults. Copy to .env and change only local secrets/ports.
# Values below are development examples, never shared-environment credentials.
COMPOSE_PROJECT_NAME=telecom-anomaly

# Public-routing reservation - owner: Stanislav (Day 03 proxy/identity handoff).
TELECOM_PUBLIC_HOST=telecom.test
PUBLIC_HTTP_PORT=8080

# Infrastructure host ports are bound to localhost only - owner: Stanislav.
POSTGRES_PORT=5432
KAFKA_HOST_PORT=9094

# Current PostgreSQL bootstrap database - owner: Stanislav. It is retained as
# legacy state during the three-database transition; do not delete its volume.
POSTGRES_DB=telecom
POSTGRES_USER=telecom_admin
POSTGRES_PASSWORD=telecom_admin_password

# Revision 3 target database names - owner: Stanislav. Day 02 provisioning creates
# only missing roles/databases and keeps the legacy database until reviewed migration.
PROCESSING_DB_NAME=processing_db
INCIDENTS_DB_NAME=incidents_db
KEYCLOAK_DB_NAME=keycloak_db

# Runtime and migrator credentials - owner: Stanislav. Runtime roles cannot create
# schema objects or connect to the other application databases.
PROCESSING_DB_USER=processing_app
PROCESSING_DB_PASSWORD=processing_app_password
PROCESSING_MIGRATOR_USER=processing_migrator
PROCESSING_MIGRATOR_PASSWORD=processing_migrator_password
INCIDENT_DB_USER=incident_app
INCIDENT_DB_PASSWORD=incident_app_password
INCIDENT_MIGRATOR_USER=incident_migrator
INCIDENT_MIGRATOR_PASSWORD=incident_migrator_password
KEYCLOAK_DB_USER=keycloak_app
KEYCLOAK_DB_PASSWORD=keycloak_app_password

# Private service endpoints - owners: Ion/Sergiu (processor), Denis (incident
# service), Sergiu (ML), Ion (generator). No application container consumes these yet.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
PROCESSING_DB_URL=jdbc:postgresql://postgres:5432/processing_db?currentSchema=app
INCIDENT_DB_URL=jdbc:postgresql://postgres:5432/incidents_db?currentSchema=app
ML_BASE_URL=http://ml-service:8000
GENERATOR_BASE_URL=http://event-generator:8081
FEATURE_VERSION=1

# Kafka topic reservation - owner: Stanislav; names/partitioning agreed with
# Ion and Sergiu before producer/consumer implementation. V1 topics remain separate.
KAFKA_TOPIC_PARTITIONS=3
KAFKA_RAW_RETENTION_MS=86400000
KAFKA_DERIVED_RETENTION_MS=604800000
KAFKA_V2_OBSERVATIONS_TOPIC=telecom.observations.v2
KAFKA_V2_KPIS_TOPIC=telecom.kpis.v2
KAFKA_V2_DETECTIONS_TOPIC=telecom.detections.v2
KAFKA_V2_INVALID_TOPIC=telecom.observations.invalid.v2
KAFKA_V2_LATE_TOPIC=telecom.observations.late.v2

# Demo/security placeholder - owner: Denis/Stanislav. Never commit a real secret in .env.
JWT_SIGNING_SECRET=change-me-local-dev

# Revision 3 standalone Java boundaries - owners: Ion/Sergiu; export variables
# before running JARs. Java services do not automatically read this Compose .env file.
# For host processes override KAFKA_BOOTSTRAP_SERVERS with the advertised host listener.
KAFKA_READINESS_TIMEOUT=2s
KAFKA_READINESS_POLL_INTERVAL=1s
GENERATOR_SEED=15092026
GENERATOR_COUNT=10
# Optional deterministic preview clock: GENERATOR_LOGICAL_TIME=2026-09-15T08:03:42Z
# Optional fixture plan: GENERATOR_FIXTURES=file:/absolute/path/seeded-intervals-v2.json
# SERVER_PORT overrides 8081 (generator) or 8083 (processor) per process.
