#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ $# -gt 1 || ( $# -eq 1 && "${1:-}" != "--with-incident-service" ) ]]; then
  echo "Usage: ./scripts/up [--with-incident-service]" >&2
  exit 2
fi

if [[ ! -f .env ]]; then
  echo "Missing .env. Follow docs/runbooks/local-dev.md to generate local passwords." >&2
  exit 1
fi

docker compose config --quiet
./scripts/check_geography_alignment.py --env-file .env
docker compose config --format json | ./scripts/check_geography_alignment.py --compose-json

echo "Starting PostgreSQL and Kafka and waiting for dependency health..."
docker compose up -d --wait --wait-timeout 120 postgres kafka

echo "Provisioning target databases before application startup..."
./scripts/prepare-databases

echo "Starting Keycloak after database provisioning and waiting for readiness..."
docker compose up -d --wait --wait-timeout 180 keycloak
./scripts/prepare-keycloak
bash ./scripts/prepare-login-theme

echo "Starting the local proxy and waiting for telecom realm discovery..."
docker compose up -d --wait --wait-timeout 120 proxy

echo "Creating Kafka topics..."
docker compose up --no-deps --force-recreate --abort-on-container-exit --exit-code-from kafka-init kafka-init

echo "Starting runnable application services and waiting for readiness..."
echo "Initializing synthetic history (the first 30-day bootstrap may take several minutes)..."
docker compose stop event-generator processor
docker compose up -d --build history-bootstrap
docker compose wait history-bootstrap
docker compose up -d --build --wait --wait-timeout 120 event-generator processor ml-service

if [[ ${1:-} == "--with-incident-service" ]]; then
  echo "Starting the Compose-managed incident service..."
  # All dependencies are already healthy; avoid rerunning the history bootstrap.
  docker compose --profile app up -d --no-deps --build --wait --wait-timeout 120 incident-service
  echo "Full Compose stack is ready. Run ./scripts/verify."
else
  echo "Compose stack is ready. Start host incident-service from services/incident-service with ./mvnw spring-boot:run, then run ./scripts/verify."
fi
