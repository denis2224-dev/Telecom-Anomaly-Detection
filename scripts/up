#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ ! -f .env ]]; then
  cp .env.example .env
  echo "Created .env from .env.example"
fi

echo "Starting PostgreSQL and Kafka and waiting for dependency health..."
docker compose up -d --wait postgres kafka

echo "Provisioning target databases before application startup..."
./scripts/prepare-databases

echo "Creating Kafka topics..."
docker compose up --wait kafka-init

echo "Starting runnable application services and waiting for readiness..."
docker compose up -d --wait event-generator processor

echo "Starting ML service; missing or invalid local models remain visibly unhealthy..."
docker compose up -d ml-service

echo "Compose stack is ready. Run ./scripts/verify for contract checks."
