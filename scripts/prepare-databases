#!/usr/bin/env bash
# Non-destructive database split for both fresh and existing postgres-data volumes.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ ! -f .env ]]; then
  echo "Missing .env. Follow docs/runbooks/local-dev.md to generate local passwords." >&2
  exit 1
fi

docker compose up -d --wait --wait-timeout 120 postgres

# Reuse the fresh-volume initializer with the running container's environment.
# Streaming the file also works for an existing postgres-data volume.
docker compose exec -T postgres bash -s < infra/postgres/init/01-create-schemas.sh

echo "Target databases are provisioned. Existing databases, data and role passwords were retained."
