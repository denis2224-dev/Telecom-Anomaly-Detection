#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi

POSTGRES_DB="${POSTGRES_DB:-telecom}"
POSTGRES_USER="${POSTGRES_USER:-telecom_admin}"

echo "Checking Docker daemon..."
docker info >/dev/null

echo "Validating Compose configuration..."
docker compose config --quiet

echo "Checking PostgreSQL readiness..."
docker compose exec -T postgres pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"

echo "Checking PostgreSQL databases and isolation..."
for database in "${PROCESSING_DB_NAME:-processing_db}" "${INCIDENTS_DB_NAME:-incidents_db}" "${KEYCLOAK_DB_NAME:-keycloak_db}"; do
  docker compose exec -T postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tAc "select 1 from pg_database where datname = '$database';" | grep -qx 1
done
for database in "${PROCESSING_DB_NAME:-processing_db}" "${INCIDENTS_DB_NAME:-incidents_db}"; do
  docker compose exec -T postgres psql -U "$POSTGRES_USER" -d "$database" -tAc "select schema_name from information_schema.schemata where schema_name = 'app';" | grep -qx app
done

echo "Checking Kafka topics..."
topics="$(docker compose exec -T kafka /opt/bitnami/kafka/bin/kafka-topics.sh --bootstrap-server kafka:9092 --list)"
echo "$topics"
grep -q "telecom.events.v1" <<<"$topics"
grep -q "telecom.detections.v1" <<<"$topics"
grep -q "telecom.telemetry.v1" <<<"$topics"

echo "Infrastructure verification passed."
