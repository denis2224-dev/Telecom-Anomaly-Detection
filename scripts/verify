#!/usr/bin/env bash
set -euo pipefail
export MSYS_NO_PATHCONV=1

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1091
  source .env
  set +a
fi

POSTGRES_DB="${POSTGRES_DB:-postgres}"
POSTGRES_USER="${POSTGRES_USER:-telecom_admin}"

echo "Checking Docker daemon..."
docker info >/dev/null

echo "Validating Compose configuration..."
docker compose config --quiet

echo "Checking PostgreSQL readiness..."
docker compose exec -T postgres pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"

echo "Checking PostgreSQL database ownership and access isolation..."
database_checks="$(docker compose exec -T postgres psql -X -v ON_ERROR_STOP=1 \
  -U "$POSTGRES_USER" -d "$POSTGRES_DB" -tA <<'SQL'
WITH expected(database_name, owner_name, runtime_name) AS (
  VALUES ('processing_db', 'processing_migrator', 'processing_app'),
         ('incidents_db', 'incidents_migrator', 'incidents_app'),
         ('keycloak_db', 'keycloak_app', 'keycloak_app')
)
SELECT bool_and(COALESCE(
  pg_get_userbyid(d.datdba) = e.owner_name
  AND r.rolcanlogin AND NOT r.rolsuper AND NOT r.rolcreatedb AND NOT r.rolcreaterole
  AND has_database_privilege(r.oid, d.oid, 'CONNECT')
  AND has_database_privilege(e.owner_name, d.oid, 'CONNECT')
  AND NOT EXISTS (
    SELECT 1 FROM expected other
    WHERE other.database_name <> e.database_name
      AND (has_database_privilege(r.oid, other.database_name, 'CONNECT')
        OR has_database_privilege(e.owner_name, other.database_name, 'CONNECT'))
  ), false))
FROM expected e
LEFT JOIN pg_database d ON d.datname = e.database_name
LEFT JOIN pg_roles r ON r.rolname = e.runtime_name;
SQL
)"
if [[ "$database_checks" != "t" ]]; then
  echo "Database ownership, role permissions or database isolation is incorrect." >&2
  exit 1
fi

for application in processing incidents; do
  echo "Checking ${application}_db.app ownership and runtime permissions..."
  schema_checks="$(docker compose exec -T postgres psql -X -v ON_ERROR_STOP=1 \
    -U "$POSTGRES_USER" -d "${application}_db" -tA \
    -v migrator="${application}_migrator" -v runtime="${application}_app" <<'SQL'
SELECT COALESCE((
  SELECT pg_get_userbyid(nspowner) = :'migrator'
    AND has_schema_privilege(:'runtime', oid, 'USAGE')
    AND NOT has_schema_privilege(:'runtime', oid, 'CREATE')
    AND NOT has_schema_privilege(:'runtime', 'public', 'CREATE')
    AND NOT has_database_privilege(:'runtime', current_database(), 'CREATE')
  FROM pg_namespace WHERE nspname = 'app'
), false);
SQL
)"
  if [[ "$schema_checks" != "t" ]]; then
    echo "${application}_db.app is missing or its ownership/runtime permissions are incorrect." >&2
    exit 1
  fi
done

echo "Checking processor ingestion tables and runtime DML grants..."
processor_tables="$(docker compose exec -T postgres psql -X -v ON_ERROR_STOP=1 \
  -U "$POSTGRES_USER" -d processing_db -tA <<'SQL'
WITH expected(name) AS (
  VALUES ('observation_receipt'), ('interval_bucket'), ('source_state'), ('rejection_outbox')
)
SELECT count(t.oid) = 4 AND bool_and(COALESCE(
  pg_get_userbyid(t.relowner) = 'processing_migrator'
  AND has_table_privilege('processing_app', t.oid, 'SELECT')
  AND has_table_privilege('processing_app', t.oid, 'INSERT')
  AND has_table_privilege('processing_app', t.oid, 'UPDATE')
  AND has_table_privilege('processing_app', t.oid, 'DELETE'), false))
FROM expected e
LEFT JOIN pg_class t ON t.relname = e.name AND t.relnamespace = 'app'::regnamespace;
SQL
)"
if [[ "$processor_tables" != "t" ]]; then
  echo "Processor migration, table ownership or runtime DML permissions are incorrect." >&2
  exit 1
fi

echo "Checking Kafka topics..."
topics="$(docker compose exec -T kafka /opt/kafka/bin/kafka-topics.sh --bootstrap-server kafka:9092 --list)"
echo "$topics"
for topic in \
  telecom.detections.v1 telecom.telemetry.v1 telecom.detections.dlq.v1 \
  "${KAFKA_V2_OBSERVATIONS_TOPIC:-telecom.observations.v2}" \
  "${KAFKA_V2_KPIS_TOPIC:-telecom.kpis.v2}" \
  "${KAFKA_V2_DETECTIONS_TOPIC:-telecom.detections.v2}" \
  "${KAFKA_V2_INVALID_TOPIC:-telecom.observations.invalid.v2}" \
  "${KAFKA_V2_LATE_TOPIC:-telecom.observations.late.v2}"; do
  if ! grep -Fxq -- "$topic" <<<"$topics"; then
    echo "Missing Kafka topic: $topic" >&2
    exit 1
  fi
done


echo "Checking application readiness..."
docker compose exec -T event-generator curl --fail --silent --show-error --max-time 5 \
  http://localhost:8081/actuator/health/readiness
docker compose exec -T processor curl --fail --silent --show-error --max-time 5 \
  http://localhost:8083/actuator/health/readiness

echo "Checking Keycloak readiness and OIDC discovery..."
docker compose exec -T event-generator curl --fail --silent --show-error --max-time 5 \
  http://keycloak:9000/health/ready
discovery="$(docker compose exec -T event-generator curl --fail --silent --show-error --max-time 5 \
  http://telecom.test:8080/auth/realms/telecom/.well-known/openid-configuration)"
if ! grep -Eq '"issuer"[[:space:]]*:[[:space:]]*"http://telecom[.]test:8080/auth/realms/telecom"' <<<"$discovery"; then
  echo "Keycloak discovery must advertise http://telecom.test:8080/auth/realms/telecom." >&2
  exit 1
fi

echo "Checking host access to the OIDC issuer..."
if ! curl --noproxy '*' --fail --silent --show-error --max-time 5 \
  http://telecom.test:8080/auth/realms/telecom/.well-known/openid-configuration >/dev/null; then
  echo "Map telecom.test to 127.0.0.1 in your hosts file and ensure the proxy is running." >&2
  exit 1
fi

echo "Checking Angular, Spring and Keycloak authentication routing..."
node scripts/check-auth-routing.mjs

echo "Infrastructure, application and Keycloak readiness verification passed."
