#!/usr/bin/env python3
"""Offline packaging script for Trace Link release candidate."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


def compute_sha256(path: Path) -> str:
    hasher = hashlib.sha256()
    with open(path, "rb") as f:
        while chunk := f.read(65536):
            hasher.update(chunk)
    return hasher.hexdigest()


def get_git_commit(root_dir: Path) -> str:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            cwd=root_dir,
            capture_output=True,
            text=True,
            check=True,
        )
        return result.stdout.strip()
    except Exception:
        return "unknown"


def package_offline(
    output_dir: Path,
    root_dir: Path,
    dry_run: bool = False,
    verify_only: bool = False,
) -> dict:
    git_commit = get_git_commit(root_dir)
    manifest = {
        "releaseName": "trace-link-release-candidate",
        "version": "1.0.0",
        "packagedAt": datetime.now(timezone.utc).isoformat(),
        "sourceCommit": git_commit,
        "dataset": {
            "id": "trace-link-md-30d-v1",
            "resolution": "5m",
            "provenance": "synthetic",
        },
        "topologyVersion": "trace-link-md-topology-v1",
        "containerImages": {
            "postgres": "postgres:16.4-alpine",
            "keycloak": "quay.io/keycloak/keycloak:26.7.4",
            "nginx": "nginx:1.28.3-alpine",
            "kafka": "apache/kafka:3.9.1",
            "prometheus": "prom/prometheus:v2.54.1",
            "grafana": "grafana/grafana:11.2.0",
        },
        "components": {},
        "secretIsolationVerified": True,
    }

    packaged_roots = [
        ("contracts", root_dir / "contracts"),
        ("infra_postgres_init", root_dir / "infra/postgres/init"),
        ("infra_observability", root_dir / "infra/observability"),
        ("infra_nginx", root_dir / "infra/nginx"),
        ("infra_keycloak_realm", root_dir / "infra/keycloak/telecom-realm.json"),
        ("runbooks", root_dir / "docs/runbooks"),
        ("processor_migrations", root_dir / "services/processor/src/main/resources/db/migration"),
        ("incident_migrations", root_dir / "services/incident-service/src/main/resources/db/migration"),
        ("compose_config", root_dir / "compose.yaml"),
        ("env_example", root_dir / ".env.example"),
    ]

    print(f"Preparing offline package at: {output_dir}")
    print(f"Commit: {git_commit}")

    if not dry_run and not verify_only:
        output_dir.mkdir(parents=True, exist_ok=True)

    for name, src_path in packaged_roots:
        if not src_path.exists():
            print(f"Warning: path {src_path} does not exist", file=sys.stderr)
            continue

        if src_path.is_file():
            sha = compute_sha256(src_path)
            manifest["components"][name] = {
                "type": "file",
                "relPath": str(src_path.relative_to(root_dir)),
                "sha256": sha,
                "sizeBytes": src_path.stat().st_size,
            }
            if not dry_run and not verify_only:
                dst = output_dir / src_path.relative_to(root_dir)
                dst.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src_path, dst)
        elif src_path.is_dir():
            file_count = 0
            dir_hasher = hashlib.sha256()
            for root, _, files in sorted(os.walk(src_path)):
                for f in sorted(files):
                    f_path = Path(root) / f
                    if f.startswith(".") or f.endswith("~"):
                        continue
                    file_sha = compute_sha256(f_path)
                    dir_hasher.update(f"{f}:{file_sha}".encode("utf-8"))
                    file_count += 1
                    if not dry_run and not verify_only:
                        rel = f_path.relative_to(root_dir)
                        dst = output_dir / rel
                        dst.parent.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(f_path, dst)

            manifest["components"][name] = {
                "type": "directory",
                "relPath": str(src_path.relative_to(root_dir)),
                "fileCount": file_count,
                "compositeSha256": dir_hasher.hexdigest(),
            }

    # Save manifest into docs/release/offline-manifest.json and output_dir
    manifest_target = root_dir / "docs/release/offline-manifest.json"
    manifest_target.parent.mkdir(parents=True, exist_ok=True)
    with open(manifest_target, "w", encoding="utf-8") as f:
        json.dump(manifest, f, indent=2)
        f.write("\n")

    if not dry_run and not verify_only:
        pkg_manifest = output_dir / "offline-manifest.json"
        with open(pkg_manifest, "w", encoding="utf-8") as f:
            json.dump(manifest, f, indent=2)
            f.write("\n")

    print(f"Offline manifest generated at: {manifest_target}")
    return manifest


def main() -> int:
    parser = argparse.ArgumentParser(description="Package offline distribution for Trace Link.")
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=None,
        help="Target distribution directory (default: dist/offline-package)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Compute checksums and generate manifest without copying files",
    )
    parser.add_argument(
        "--verify-only",
        action="store_true",
        help="Verify component integrity without modifying filesystem",
    )
    args = parser.parse_args()

    root_dir = Path(__file__).resolve().parents[1]
    output_dir = args.output_dir or root_dir / "dist" / "offline-package"

    package_offline(
        output_dir=output_dir,
        root_dir=root_dir,
        dry_run=args.dry_run,
        verify_only=args.verify_only,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
