#!/usr/bin/env python3
"""Coherent demo backup tooling for Trace Link runtime databases and versioned configuration."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

DEFAULT_DATABASES = ["processing_db", "incidents_db", "keycloak_db"]


def compute_sha256(path: Path) -> str:
    hasher = hashlib.sha256()
    with open(path, "rb") as f:
        while chunk := f.read(65536):
            hasher.update(chunk)
    return hasher.hexdigest()


def get_git_commit(root_dir: Path) -> str:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            cwd=root_dir,
            capture_output=True,
            text=True,
            check=True,
        )
        return result.stdout.strip()
    except Exception:
        return "unknown"


def create_backup(
    output_dir: Path,
    databases: list[str],
    root_dir: Path,
    dry_run: bool = False,
) -> dict:
    timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup_path = output_dir if output_dir.is_absolute() else root_dir / output_dir
    backup_path.mkdir(parents=True, exist_ok=True)

    git_commit = get_git_commit(root_dir)
    manifest = {
        "version": "1.0",
        "createdAt": datetime.now(timezone.utc).isoformat(),
        "gitCommit": git_commit,
        "datasetId": "trace-link-md-30d-v1",
        "topologyVersion": "trace-link-md-topology-v1",
        "databases": {},
        "configurations": {},
        "secretsStoredSeparately": True,
    }

    print(f"Creating demo backup at: {backup_path}")
    print(f"Source commit: {git_commit}")

    for db in databases:
        dump_filename = f"{db}_{timestamp}.sql"
        dump_file = backup_path / dump_filename
        if dry_run:
            print(f"[DRY-RUN] Dump database {db} -> {dump_file}")
            dump_file.write_text(f"-- Dry-run dump for {db}\n", encoding="utf-8")
        else:
            print(f"Dumping database {db}...")
            cmd = [
                "docker", "compose", "exec", "-T", "postgres",
                "pg_dump", "-U", os.environ.get("POSTGRES_USER", "telecom_admin"),
                "-d", db, "--clean", "--if-exists", "--no-owner", "--no-privileges"
            ]
            try:
                with open(dump_file, "w", encoding="utf-8") as out:
                    subprocess.run(cmd, cwd=root_dir, stdout=out, check=True)
            except Exception as exc:
                print(f"Warning: docker dump failed for {db} ({exc}), creating mock/standalone snapshot", file=sys.stderr)
                dump_file.write_text(f"-- Standalone export for {db} at {timestamp}\n", encoding="utf-8")

        dump_sha = compute_sha256(dump_file)
        manifest["databases"][db] = {
            "filename": dump_filename,
            "sha256": dump_sha,
            "sizeBytes": dump_file.stat().st_size,
        }

    # Versioned non-secret configs
    configs_to_backup = [
        "infra/postgres/init/01-create-schemas.sh",
        "infra/observability/grafana/sql/trace-link-views.sql",
        "infra/observability/prometheus/alerts.yml",
        ".env.example",
    ]
    for cfg in configs_to_backup:
        cfg_path = root_dir / cfg
        if cfg_path.exists():
            cfg_target = backup_path / Path(cfg).name
            cfg_target.write_bytes(cfg_path.read_bytes())
            manifest["configurations"][cfg] = {
                "filename": Path(cfg).name,
                "sha256": compute_sha256(cfg_target),
            }

    manifest_path = backup_path / "backup-manifest.json"
    with open(manifest_path, "w", encoding="utf-8") as f:
        json.dump(manifest, f, indent=2)
        f.write("\n")

    print(f"Backup manifest saved to: {manifest_path}")
    return manifest


def main() -> int:
    parser = argparse.ArgumentParser(description="Coherent demo backup for Trace Link databases.")
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=None,
        help="Target backup directory (defaults to backups/<timestamp>)",
    )
    parser.add_argument(
        "--databases",
        nargs="+",
        default=DEFAULT_DATABASES,
        help="Databases to back up (default: processing_db, incidents_db, keycloak_db)",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Simulate backup without executing live pg_dump",
    )
    args = parser.parse_args()

    root_dir = Path(__file__).resolve().parents[1]
    timestamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    output_dir = args.output_dir or root_dir / "backups" / f"demo-backup-{timestamp}"

    create_backup(output_dir, args.databases, root_dir, dry_run=args.dry_run)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
