<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>md.utm.telecom</groupId><artifactId>telecom-anomaly-detection</artifactId>
    <version>0.3.0-SNAPSHOT</version><relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>streaming-support</artifactId>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.kafka</groupId><artifactId>spring-kafka</artifactId></dependency>
    <dependency><groupId>com.networknt</groupId><artifactId>json-schema-validator</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
        <executions><execution><id>pure-contracts</id><goals><goal>jar</goal></goals>
          <configuration><classifier>contracts</classifier>
            <includes><include>md/utm/telecom/observation/**</include><include>contracts/**</include></includes>
            <excludes><exclude>md/utm/telecom/observation/GeographicRuntimeConfiguration*</exclude></excludes>
          </configuration>
        </execution></executions>
      </plugin>
    </plugins>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource>
        <directory>../../contracts</directory><targetPath>contracts</targetPath>
        <includes><include>policies/trace-link-live-synthetic-rules-v1.json</include><include>detections/trace-link-live-*.schema.json</include><include>observations/**</include><include>topology/**</include><include>geography/**</include><include>coverage/**</include><include>kpi/**</include><include>datasets/**</include><include>fixtures/geography/**</include><include>fixtures/coverage/**</include><include>fixtures/observations/**</include><include>fixtures/validation/**</include></includes>
      </resource>
    </resources>
    <testResources>
      <testResource><directory>src/test/resources</directory></testResource>
      <testResource>
        <directory>../../contracts</directory><targetPath>contracts</targetPath>
        <includes><include>fixtures/features/voice-worked-v2.json</include><include>fixtures/trace-link/domain-window-cases-v1.json</include></includes>
      </testResource>
    </testResources>
  </build>
</project>
