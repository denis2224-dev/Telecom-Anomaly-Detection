<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>md.utm.telecom</groupId><artifactId>telecom-anomaly-detection</artifactId>
    <version>0.3.0-SNAPSHOT</version><relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>processor</artifactId>
  <dependencies>
    <dependency><groupId>md.utm.telecom</groupId><artifactId>event-generator</artifactId>
      <version>${project.version}</version><classifier>library</classifier></dependency>
    <dependency><groupId>md.utm.telecom</groupId><artifactId>streaming-support</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-configuration-processor</artifactId><optional>true</optional></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.kafka</groupId><artifactId>spring-kafka-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>kafka</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>../../contracts</directory><targetPath>contracts</targetPath>
        <includes><include>topology/trace-link-runtime-dependencies-v1.json</include><include>explanations/**</include><include>policies/**</include><include>baselines/**</include><include>features/**</include><include>detections/**</include><include>evidence/**</include><include>kpi/**</include><include>fixtures/features/**</include><include>fixtures/detections/**</include></includes>
      </resource>
    </resources>
    <testResources>
      <testResource><directory>src/test/resources</directory></testResource>
      <testResource><directory>../../contracts</directory><targetPath>contracts</targetPath>
        <includes><include>fixtures/trace-link/**</include></includes>
      </testResource>
    </testResources>
    <plugins>
      <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
        <configuration><includes>
          <include>**/Test*.java</include><include>**/*Test.java</include><include>**/*Tests.java</include>
          <include>**/*TestCase.java</include><include>**/LateInputIT.java</include>
          <include>**/ReplayIT.java</include><include>**/FinalizerRaceIT.java</include>
          <include>**/DetectionReplayIT.java</include>
          <include>**/DependencyOutageIT.java</include><include>**/TraceLinkDatasetBootstrapIT.java</include><include>**/TraceLinkProjectionIT.java</include><include>**/TraceLinkDetectionIT.java</include>
        </includes></configuration>
      </plugin>
    </plugins></build>
</project>
