# Ensure shell scripts retain LF line endings on Windows for Docker compatibility
*.sh text eol=lf
scripts/* text eol=lf

# Linux image builds execute the Maven wrapper directly.
/mvnw text eol=lf

services/ml-service/training/split_manifest.json text eol=lf
services/ml-service/models/*-calibration.json text eol=lf
services/ml-service/models/manifest.json text eol=lf
services/ml-service/models/*.joblib binary
docs/evidence/*-sms-supervised*.json text eol=lf

# Preserve raw hashes of immutable SMS validation reports across checkouts.
tasks/sms-ml-shadow-integration/replay-*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
tasks/sms-ml-shadow-integration/replay-*.md -text whitespace=trailing-space,space-before-tab,cr-at-eol
tasks/sms-ml-shadow-integration/prior-runs.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
tasks/sms-ml-shadow-integration/prior-runs.md -text whitespace=trailing-space,space-before-tab,cr-at-eol
tasks/sms-ml-shadow-integration/verification.json -text whitespace=trailing-space,space-before-tab,cr-at-eol

# Day 1 exports identify the exact frozen fixture bytes on every checkout.
contracts/fixtures/trace-link/arithmetic-cases.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
contracts/geography/demo-geography-v1.json -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/evidence/assets/trace-link-day1/*.json -text whitespace=trailing-space,space-before-tab,cr-at-eol

# The bounded native archive is verified byte-for-byte on Windows and Linux.
contracts/fixtures/trace-link/native-slice/* text eol=lf
contracts/datasets/*.manifest.json text eol=lf
docs/evidence/assets/trace-link-ion-native/*.json text eol=lf
