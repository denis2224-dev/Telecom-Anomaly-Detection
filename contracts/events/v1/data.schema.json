{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/telecom/events/v1/data.schema.json",
  "title": "DATA payload v1.0",
  "description": "One completed synthetic mobile data session.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "networkNodeId", "bytesUploaded", "bytesDownloaded", "durationSeconds"],
  "properties": {
    "sessionId": {"type": "string", "pattern": "^SESSION-[A-Z0-9]+(-[A-Z0-9]+)*$", "maxLength": 64, "description": "Synthetic session ID.", "not": {"pattern": "\\s"}},
    "networkNodeId": {"type": "string", "pattern": "^NODE-[A-Z0-9]+(-[A-Z0-9]+)*$", "maxLength": 64, "description": "Node serving the session. Handovers are not modeled in v1.0.", "not": {"pattern": "\\s"}},
    "bytesUploaded": {"type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "User-data bytes uploaded during the session."},
    "bytesDownloaded": {"type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "User-data bytes downloaded during the session."},
    "durationSeconds": {"type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "Session duration in whole seconds."}
  }
}
