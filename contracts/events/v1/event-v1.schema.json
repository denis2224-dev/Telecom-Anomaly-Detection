{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/telecom/events/v1/event-v1.schema.json",
  "title": "Synthetic telecom EventV1, version 1.0",
  "description": "Kafka value for telecom.events.v1. Key: entityType:entityId.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "schemaVersion", "eventType", "occurredAt", "entityType", "entityId", "payload"],
  "properties": {
    "eventId": {"$ref": "#/$defs/uuidV4", "description": "Unique event ID used for deduplication. Kept on re-delivery."},
    "schemaVersion": {"type": "string", "const": "1.0", "description": "Event contract version."},
    "eventType": {"type": "string", "enum": ["CALL", "SMS", "DATA", "AUTH", "NETWORK"], "description": "Selects the payload type."},
    "occurredAt": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$", "description": "UTC event time ending in Z. For NETWORK, it is the window end."},
    "entityType": {"type": "string", "enum": ["SUBSCRIBER", "NETWORK_NODE", "NETWORK_LINK"], "description": "Entity type used in the Kafka key."},
    "entityId": {"type": "string", "maxLength": 64, "description": "Synthetic entity ID used in the Kafka key.", "not": {"pattern": "\\s"}},
    "scenarioRunId": {"$ref": "#/$defs/uuidV4", "description": "Used only to trace simulator runs. Not used for detection."},
    "payload": {"type": "object", "description": "Fields for the selected event type."}
  },
  "$defs": {
    "uuidV4": {"type": "string", "format": "uuid", "minLength": 36, "maxLength": 36, "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
  },
  "allOf": [
    {
      "oneOf": [
        {"properties": {"entityType": {"const": "SUBSCRIBER"}, "entityId": {"pattern": "^SUB-[0-9]{6,12}$"}}},
        {"properties": {"entityType": {"const": "NETWORK_NODE"}, "entityId": {"pattern": "^NODE-[A-Z0-9]+(-[A-Z0-9]+)*$"}}},
        {"properties": {"entityType": {"const": "NETWORK_LINK"}, "entityId": {"pattern": "^LINK-[A-Z0-9]+(-[A-Z0-9]+)*$"}}}
      ]
    }
  ],
  "oneOf": [
    {"properties": {"eventType": {"const": "CALL"}, "entityType": {"const": "SUBSCRIBER"}, "payload": {"$ref": "call-v1.schema.json"}}},
    {"properties": {"eventType": {"const": "SMS"}, "entityType": {"const": "SUBSCRIBER"}, "payload": {"$ref": "sms-v1.schema.json"}}},
    {"properties": {"eventType": {"const": "DATA"}, "entityType": {"const": "SUBSCRIBER"}, "payload": {"$ref": "data-v1.schema.json"}}},
    {"properties": {"eventType": {"const": "AUTH"}, "entityType": {"const": "SUBSCRIBER"}, "payload": {"$ref": "auth-v1.schema.json"}}},
    {
      "properties": {"eventType": {"const": "NETWORK"}, "entityType": {"enum": ["NETWORK_NODE", "NETWORK_LINK"]}, "payload": {"$ref": "network-v1.schema.json"}},
      "if": {"properties": {"entityType": {"const": "NETWORK_LINK"}}},
      "then": {"properties": {"payload": {"required": ["linkId"]}}},
      "else": {"properties": {"payload": {"not": {"required": ["linkId"]}}}}
    }
  ]
}
