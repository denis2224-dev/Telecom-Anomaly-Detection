{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telecom:trace-link-domain-measurement-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mappingVersion",
    "sourceKind",
    "sourcePayloadBase64",
    "sourcePayloadSha256",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "trace-link-domain-measurement-v1"
    },
    "mappingVersion": {
      "const": "trace-link-domain-mapping-v1"
    },
    "sourceKind": {
      "enum": [
        "LIVE_60",
        "NATIVE_300"
      ]
    },
    "sourcePayloadBase64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 900000
    },
    "sourcePayloadSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestSha256",
        "generatorVersion",
        "seed"
      ],
      "properties": {
        "manifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generatorVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    }
  }
}
