        "minDeliveredSamples": {
          "type": "integer",
          "minimum": 1
        },
        "p95DelayMsStrictlyGreaterThan": {
          "type": "integer",
          "minimum": 0
        },
        "baselineMultiplierStrictlyGreaterThan": {
          "type": "integer",
          "minimum": 0
        },
        "queueDepthAtLeast": {
          "type": "integer",
          "minimum": 0
