      "minimum": 0
    },
    "openAfterBreachedWindows": {
      "type": "integer",
      "minimum": 1
    },
    "recoverAfterHealthyWindows": {
      "type": "integer",
      "minimum": 1
    },
    "heartbeatIntervalSec": {
      "type": "integer",
      "minimum": 1
    },
    "staleAfterSec": {
      "type": "integer",
      "minimum": 1
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "dropPpStrictlyGreaterThan": {
          "type": "number",
          "minimum": 0
        },
        "recoveryDropPpAtMost": {
          "type": "number",
          "minimum": 0
        },
        "highExtraFailuresAtLeast": {
          "type": "integer",
          "minimum": 0
        },
        "criticalExtraFailuresAtLeast": {
          "type": "integer",
          "minimum": 0
        },
        "imsCapacityCpuPctAtLeast": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "imsCapacitySip503CountAtLeast": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "imsCapacityAccessSrDropPpAtMost": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "minAttempts",
        "dropPpStrictlyGreaterThan",
        "recoveryDropPpAtMost",
        "highExtraFailuresAtLeast",
        "criticalExtraFailuresAtLeast",
        "imsCapacityCpuPctAtLeast",
        "imsCapacitySip503CountAtLeast",
        "imsCapacityAccessSrDropPpAtMost"
