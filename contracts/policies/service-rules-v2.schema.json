        "minDeliveredSamples",
        "p95DelayMsStrictlyGreaterThan",
        "baselineMultiplierStrictlyGreaterThan",
        "queueDepthAtLeast",
        "oldestPendingSecStrictlyGreaterThan",
        "recoveryP95DelayMsAtMost",
        "recoveryBaselineMultiplierAtMost",
        "recoveryOldestPendingSecAtMost",
        "highAffectedDeliveriesAtLeast",
        "criticalQueueDepthAtLeast",
        "criticalOldestPendingSecAtLeast"
      ]
