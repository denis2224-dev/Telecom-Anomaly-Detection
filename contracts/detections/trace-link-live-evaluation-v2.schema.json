{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:telecom:trace-link-live-evaluation-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "baselineVersion",
    "baselineMode",
    "receiverId",
    "receivedAt",
    "evaluatedAt",
    "primaryMetric",
    "measurements"
  ],
  "properties": {
    "schemaVersion": {
      "const": "trace-link-live-evaluation-v2"
    },
    "policyVersion": {
      "const": "trace-link-live-synthetic-rules-v1"
    },
    "baselineVersion": {
      "const": "trace-link-live-static-baseline-v1"
    },
    "baselineMode": {
      "enum": [
        "STATIC_SYNTHETIC_ONLY",
        "UNAVAILABLE"
      ]
    },
    "receiverId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "primaryMetric": {
      "enum": [
        "transport.link.utilization",
        "roaming.registration.success",
        "mobileData.dns.success",
        "mobileData.activation.success"
      ]
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "mappingVersion",
          "sourceKind",
          "sourcePayloadBase64",
          "sourcePayloadSha256",
          "provenance"
        ],
        "properties": {
          "schemaVersion": {
            "const": "trace-link-domain-measurement-v1"
          },
          "mappingVersion": {
            "const": "trace-link-domain-mapping-v1"
          },
          "sourceKind": {
            "enum": [
              "LIVE_60",
              "NATIVE_300"
            ]
          },
          "sourcePayloadBase64": {
            "type": "string",
            "minLength": 1,
            "maxLength": 900000
          },
          "sourcePayloadSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "manifestSha256",
              "generatorVersion",
              "seed"
            ],
            "properties": {
              "manifestSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "generatorVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "seed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              }
            }
          }
        }
      }
    }
  }
}
