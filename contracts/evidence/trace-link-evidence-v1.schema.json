    "ruleVersion": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 160
    },
    "modelVersion": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 160
