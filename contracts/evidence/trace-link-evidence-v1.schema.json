              "pattern": "Z$"
            }
          },
          "required": [
            "type",
            "state",
            "at"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "SNAPSHOT_DIFFERENCE"
            },
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "start",
            "end"
          ]
