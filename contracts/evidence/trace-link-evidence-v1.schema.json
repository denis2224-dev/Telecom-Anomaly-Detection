    "threshold",
    "deviation",
    "coverage",
    "freshness",
    "scope",
    "window",
    "quality",
    "dependencyRelationId",
    "dependency",
    "topologyVersion",
    "ruleVersion",
    "modelVersion",
    "provenance",
    "observedRevision",
    "generatedAt"
