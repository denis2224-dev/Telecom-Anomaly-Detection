              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "from": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            },
            "to": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
