{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "measurementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "metricId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "unit": {
      "enum": [
        "COUNT",
        "PERCENT",
        "ERLANG",
        "SECONDS",
        "MILLISECONDS",
        "GBPS",
        "BYTES",
        "MBPS",
        "STATE"
      ]
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "primitives": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "RATIO"
            },
            "numerator": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "denominator": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "numerator",
            "denominator"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "SUM_COUNT"
            },
            "sum": {
              "type": "number",
              "minimum": 0
            },
            "count": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "sum",
            "count"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "HISTOGRAM"
