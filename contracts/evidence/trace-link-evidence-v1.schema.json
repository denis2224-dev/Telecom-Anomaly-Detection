                },
                "representation": {
                  "const": "NON_CUMULATIVE_FINITE_BINS"
                },
                "edges": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "counts": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              },
              "required": [
                "schemaVersion",
                "unit",
                "representation",
                "edges",
                "counts"
              ]
            }
          },
          "required": [
            "type",
            "histogram"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "SNAPSHOT"
            },
            "value": {
              "type": "number",
              "minimum": 0
            },
            "snapshotAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$"
            }
          },
          "required": [
            "type",
            "value",
            "snapshotAt"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "COUNT"
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "count"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "TIME_WEIGHTED"
            },
            "weightedSum": {
              "type": "number",
              "minimum": 0
            },
            "validSeconds": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "type",
            "weightedSum",
            "validSeconds"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
