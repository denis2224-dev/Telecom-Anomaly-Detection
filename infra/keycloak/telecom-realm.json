{
  "realm": "telecom",
  "enabled": true,
  "displayName": "Telecom local development",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {"name": "ANALYST"},
      {"name": "SUPERVISOR"},
      {"name": "ADMIN"}
    ]
  },
  "clients": [
    {
      "clientId": "telecom-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://telecom.test:8080/login/oauth2/code/keycloak"],
      "webOrigins": ["http://telecom.test:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://telecom.test:8080/signed-out"
      },
      "defaultClientScopes": ["profile", "email", "roles"],
      "protocolMappers": [
        {
          "name": "app_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "app_roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
