{
  "name": "telecom-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:branding": "node ../../scripts/sync-branding.mjs",
    "check:branding": "node ../../scripts/sync-branding.mjs --check",
    "prestart": "npm run check:branding",
    "prestart:fixtures": "npm run check:branding",
    "prebuild": "npm run check:branding",
    "prebuild:fixtures": "npm run check:branding",
    "pretest": "npm run check:branding",
    "pretest:theme": "npm run check:branding",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "start:fixtures": "ng serve --configuration fixtures --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "build:fixtures": "ng build --configuration fixtures",
    "generate:api": "openapi-typescript api/incident-api.yaml -o src/app/core/api/schema.ts",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "test:theme": "node ../../scripts/run-theme-tests.mjs",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:auth-routing": "node ../../scripts/check-auth-routing.mjs",
    "test:branding": "node --test ../../scripts/sync-branding.test.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs"
  },
  "dependencies": {
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/platform-browser": "21.2.23",
    "@angular/router": "21.2.23",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.23",
    "@playwright/test": "^1.63.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  }
}
